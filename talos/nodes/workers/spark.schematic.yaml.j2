---
customization:
  extraKernelArgs:
    - arm64.nobti # Required on GB10, otherwise CUDA libraries fail to load
    - pci=pcie_bus_safe # Without it ConnectX-7 uses 128B PCIe payload and tops out ~97Gb/s instead of ~110Gb/s
  systemExtensions:
    officialExtensions:
      - siderolabs/nonfree-kmod-nvidia-production # Proprietary NVIDIA kernel modules
      - siderolabs/nvidia-container-toolkit-production # Must match the kmod driver version
