---
apiVersion: v1alpha1
kind: HostnameConfig
hostname: spark # TODO: confirm hostname
---
# TODO: fill from `talosctl get links -n <ip> --insecure` while booted from the ISO
apiVersion: v1alpha1
kind: LinkAliasConfig
name: net0
selector:
  match: link.driver == "TODO" && mac(link.permanent_addr).startsWith("TODO:")
---
apiVersion: v1alpha1
kind: BondConfig
name: bond0 # Same name as the mini PCs so Cilium's `devices: bond+` matches (aliases are not kernel names)
links:
  - net0
bondMode: active-backup
# TODO: add mtu: 9000 only once the Spark NIC/driver is confirmed to support it (mini PCs use 9000)
---
apiVersion: v1alpha1
kind: DHCPv4Config
name: bond0
clientIdentifier: mac
---
apiVersion: v1alpha1
kind: UnattendedInstallConfig
provisioning:
  diskSelector:
    match: system_disk # TODO: replace with disk.model == "..." once known (`talosctl get disks --insecure`)
  wipe: false
---
apiVersion: v1alpha1
kind: KubeNodeConfig
labels:
  topology.kubernetes.io/zone: m # TODO: confirm zone
  node.kubernetes.io/gpu: "true"
  node.kubernetes.io/ai: "true"
taints:
  ai: "true:NoSchedule" # Only workloads that tolerate this run here (keeps Rook, apps off the Spark)
---
# GPU Operator is installed with driver/toolkit disabled; Talos extensions provide them
apiVersion: v1alpha1
kind: KernelModuleConfig
name: nvidia
---
apiVersion: v1alpha1
kind: KernelModuleConfig
name: nvidia_uvm
---
apiVersion: v1alpha1
kind: KernelModuleConfig
name: nvidia_drm
---
apiVersion: v1alpha1
kind: KernelModuleConfig
name: nvidia_modeset
---
# GPU and OS share one unified-memory pool; keep headroom for the kubelet and system daemons
apiVersion: v1alpha1
kind: KubeletConfig
config:
  systemReserved:
    memory: 8Gi
  kubeReserved:
    memory: 2Gi
